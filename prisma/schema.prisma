generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyAnalyses  WeeklyAnalysis[]
  dailyPlans      DailyPlan[]
  trades          Trade[]
  nlpSessions     NlpSession[]
  habits          Habit[]
  habitLogs       HabitLog[]
  badges          UserBadge[]
  coachMessages   CoachMessage[]
  gamification    GamificationProfile?
  notificationSettings NotificationSettings?
}

model WeeklyAnalysis {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Market Structure on Weekly
  marketStructure String // BULLISH, BEARISH, RANGING
  keyLevel        String // description of key S/R levels
  trendDescription String

  // HTF Bias
  htfBias         String // LONG, SHORT, NEUTRAL
  biasReasoning   String // why this bias

  // Key zones
  weeklySupport   String
  weeklyResistance String
  weeklyPOI       String // points of interest

  // Notes
  notes           String?

  dailyPlans DailyPlan[]
}

model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyAnalysisId String?
  weeklyAnalysis   WeeklyAnalysis? @relation(fields: [weeklyAnalysisId], references: [id])

  // Daily Structure
  dailyBias          String // LONG, SHORT, NEUTRAL
  dailyMarketStructure String // BULLISH, BEARISH, RANGING
  alignedWithHTF     Boolean // is this aligned with weekly bias?

  // Session planning
  asianSessionNotes  String?
  londonSessionNotes String?
  nySessionNotes     String?

  // Key daily levels
  dailySupport       String
  dailyResistance    String
  dailyPOI           String

  // Trade plan
  maxTrades          Int     @default(3)
  riskPerTrade       Float   @default(1.0) // percentage
  tradePlan          String  // detailed plan for the day

  // End of day review
  reviewNotes        String?
  followedPlan       Boolean?
  emotionalState     String? // CALM, ANXIOUS, FOMO, REVENGE, CONFIDENT
  lessonLearned      String?

  trades Trade[]
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyPlanId String?
  dailyPlan   DailyPlan? @relation(fields: [dailyPlanId], references: [id])

  // Trade details
  pair            String // e.g. EUR/USD, BTC/USD
  direction       String // LONG, SHORT
  entryPrice      Float
  stopLoss        Float
  takeProfit      Float
  positionSize    Float
  riskRewardRatio Float

  // Execution
  entryTime       DateTime
  exitTime        DateTime?
  exitPrice       Float?
  status          String   @default("OPEN") // OPEN, CLOSED_WIN, CLOSED_LOSS, CLOSED_BE, CANCELLED

  // Alignment check
  alignedWithHTF     Boolean
  alignedWithDaily   Boolean
  setupType          String  // e.g. "BOS_RETEST", "FVG_FILL", "ORDER_BLOCK", "LIQUIDITY_SWEEP"

  // Result
  pnl             Float?
  pnlPercentage   Float?

  // Journal
  entryReason     String
  exitReason      String?
  screenshot      String? // URL or path
  mistakes        String?
  lessonsLearned  String?
  emotionalState  String? // CALM, ANXIOUS, FOMO, REVENGE, CONFIDENT
  rating          Int?    // 1-5 self-rating of trade quality
}

// ── NLP & Coaching Models ──────────────────────────────────────────

model NlpSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  technique   String  // ANCHORING, REFRAMING, SWISH, VISUALIZATION, MODELING, MIRRORING, INCANTATIONS, DIALOGUE
  duration    Int     // minutes spent
  notes       String?
  rating      Int?    // 1-5 effectiveness rating
  triggerError String? // which trading error triggered this session
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  name        String
  description String?
  category    String  // PRE_TRADE, POST_TRADE, NLP, MINDSET, RISK_MANAGEMENT
  frequency   String  @default("DAILY") // DAILY, WEEKLY
  isActive    Boolean @default(true)

  logs HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  completed Boolean  @default(true)
  notes     String?

  @@unique([habitId, date])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  badgeType   String // e.g. STREAK_7, STREAK_30, NLP_MASTER, DISCIPLINE_KING, etc.
  badgeName   String
  description String
}

model CoachMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  role    String // USER, COACH
  content String
  context String? // optional trading context that informed the response
}

model GamificationProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  totalPoints     Int @default(0)
  currentStreak   Int @default(0)
  longestStreak   Int @default(0)
  level           Int @default(1)
  nlpSessionsTotal Int @default(0)
  habitsCompleted Int @default(0)
}

model NotificationSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  // WhatsApp settings
  whatsappEnabled  Boolean @default(false)
  whatsappNumber   String? // international format e.g. +1234567890
  reportTime       String  @default("07:00") // HH:mm format
  timezone         String  @default("UTC")

  // Report preferences
  includeTradeStats   Boolean @default(true)
  includeDailyPlan    Boolean @default(true)
  includeHabitReminder Boolean @default(true)
  includeAiInsights   Boolean @default(true)
}
